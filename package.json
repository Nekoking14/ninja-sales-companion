{
  "name": "ninja-sales-companion",
  "version": "0.1.0",
  "description": "NinjaOne Sales Companion — local call dashboard",
  "author": "NinjaOne Sales Team",
  "main": "electron/main.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "dev": "concurrently -n SERVER,CLIENT -c cyan,magenta \"node server/index.js\" \"cd client && npm run dev\"",
    "electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm --prefix client run build",
    "start": "cross-env NODE_ENV=production electron .",
    "pack": "npm run build && electron-builder"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron-builder": "^24.13.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ninjaone.sales-companion",
    "productName": "NinjaOne Sales Companion",
    "asar": false,
    "files": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": ["**/*", "!node_modules/.cache/**", "!node_modules/.bin/**"]
      },
      {
        "from": "client/dist",
        "to": "client/dist"
      }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
